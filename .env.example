# Copy to ".env" (same folder as app.py) to override defaults. All values are optional.
# Existing environment variables take precedence over this file.

# Local Ollama server and default model
CLIPFORGE_OLLAMA_URL=http://127.0.0.1:11434
CLIPFORGE_OLLAMA_MODEL=qwen2.5:3b
# Seconds to wait for one model response (small CPU-only machines may need more)
CLIPFORGE_OLLAMA_TIMEOUT=600

# Full path to ffmpeg.exe if it is not on PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
# CLIPFORGE_FFMPEG=

# Automatic facecam detection settings
CLIPFORGE_FACECAM_SAMPLE_FRAMES=12
CLIPFORGE_FACECAM_MIN_CONFIDENCE=0.25

# DEBUG, INFO, WARNING or ERROR
CLIPFORGE_LOG_LEVEL=INFO
